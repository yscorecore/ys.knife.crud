# pnpm 配置
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true
# 使用默认 isolated（symlink）linker：symlink 重写是单文件 unlink，不触发目录递归删除。
node-linker=isolated

# 国内镜像源（下载提速，避免官方源卡顿/超时）
registry=https://registry.npmmirror.com

# 发布到 npm 时使用官方源 + 公共访问权限（scoped 包默认为 restricted）
# npmmirror 是只读镜像，发布请显式指定官方源：
#   pnpm publish --registry https://registry.npmjs.org/ --access public
# 发布前执行: pnpm login（或 npm login，token 已存在 ~/.npmrc）
