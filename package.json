{
  "name": "ys-knife-crud-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Monorepo for ys.knife.crud — TypeScript CRUD toolkit libraries published to npm",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r run test:watch",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint \"packages/*/src/**/*.ts\"",
    "clean": "pnpm -r run clean && rimraf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.18.2"
  }
}
