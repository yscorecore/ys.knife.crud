{
  "name": "@ys.knife.crud/core",
  "version": "0.0.1",
  "description": "Framework-agnostic CRUD core: data source contract, in-memory implementation and queryable CRUD manager",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "crud",
    "datasource",
    "typescript"
  ],
  "license": "MIT",
  "author": "Pengbo",
  "homepage": "https://github.com/yscorecore/ys.knife.crud#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yscorecore/ys.knife.crud.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/yscorecore/ys.knife.crud/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "postversion": "git push && git push --tags"
  },
  "dependencies": {
    "ys.knife.query.js": "^0.0.24"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.6",
    "typescript": "^5.9.2",
    "vitest": "^3.0.2"
  }
}
