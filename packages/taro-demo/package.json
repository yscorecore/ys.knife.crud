    "@tarojs/taro": "4.3.1",
    "@ys-knife-crud/core": "workspace:*",
    "@ys-knife-crud/taro": "workspace:*",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@tarojs/cli": "4.3.1",
    "@tarojs/webpack5-runner": "4.3.1",
    "@types/node": "^22.10.5",
    "@types/webpack-env": "^1.13.6",
    "@vue/babel-plugin-jsx": "^1.2.5",
    "babel-preset-taro": "4.3.1",
    "miniprogram-automator": "^0.12.1",
