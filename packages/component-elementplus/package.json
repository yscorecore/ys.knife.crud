{
  "name": "@ys.knife.crud/component-elementplus",
  "version": "0.1.0",
  "description": "Vue 3 + element-plus UI components for ys.knife.crud",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "crud",
    "vue3",
    "element-plus",
    "component-library"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/yscorecore/ys.knife.crud.git",
    "directory": "packages/component-elementplus"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "element-plus": "^2.7.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@ys.knife.crud/core": "workspace:*",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.11.7",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.6",
    "typescript": "^5.9.2",
    "vitest": "^3.0.2",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
