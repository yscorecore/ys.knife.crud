{
  "name": "@ys-knife-crud/vue",
  "version": "0.0.2",
  "description": "Vue 3 composables for ys.knife.crud (column config, excel export, row actions, row selection) — UI-library agnostic",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "crud",
    "vue3",
    "composables",
    "table"
  ],
  "license": "MIT",
  "author": "Pengbo",
  "homepage": "https://github.com/yscorecore/ys.knife.crud#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yscorecore/ys.knife.crud.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/yscorecore/ys.knife.crud/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "postversion": "git push && git push --tags"
  },
  "dependencies": {
    "@ys-knife-crud/core": "workspace:*",
    "ys.knife.query.js": "^0.0.24"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "happy-dom": "^15.11.7",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.6",
    "typescript": "^5.9.2",
    "vitest": "^3.0.2",
    "vue": "^3.5.13"
  }
}
