{
  "name": "@ys-knife-crud/antd",
  "version": "0.0.7",
  "description": "React + antd UI components for ys.knife.crud",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "crud",
    "react",
    "antd",
    "component-library"
  ],
  "license": "MIT",
  "author": "Pengbo",
  "homepage": "https://github.com/yscorecore/ys.knife.crud#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yscorecore/ys.knife.crud.git",
    "directory": "packages/antd"
  },
  "bugs": {
    "url": "https://github.com/yscorecore/ys.knife.crud/issues"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "antd": "^5.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "dependencies": {
    "@ys-knife-crud/core": "workspace:*",
    "@ys-knife-crud/react": "workspace:*",
    "dayjs": "^1.11.23"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "antd": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^5.1.0",
    "vite-plugin-lib-inject-css": "^2.2.2"
  }
}
